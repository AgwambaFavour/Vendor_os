# Copy this to .env and fill in real values. Never commit .env itself.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: comma-separated phone numbers (international format, no "+")
# who should see Status posts. Only needed for pinpoint testing — it
# overrides everything else when set. E.g. STATUS_JID_LIST=2348012345678,2348098765432
STATUS_JID_LIST=

# Optional: set to "true" to broadcast Status posts to everyone in your
# synced WhatsApp contacts, instead of just the customers table. Requires
# a fresh QR pairing after enabling syncFullHistory (see README).
STATUS_BROADCAST_ALL_CONTACTS=false

LOG_LEVEL=silent
